{
    "name": "omega-mvc/framework",
    "type": "library",
    "version": "1.0.0",
    "description": "OmegaFramework is a lightweight and modular PHP framework designed for building modern web applications following the MVC architecture. It is optimized for PHP 8.4+ and provides a simple, extensible foundation for rapid application development.",
    "keywords": [
    	"lightweight",
    	"php",
    	"modular",
    	"framework",
    	"web-development",
    	"mvc",
    	"php8"
    ],
    "homepage": "https://omega-mvc.github.io",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "Adriano Giovannini",
            "email": "agisoftt@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "omega-mvc/gettext": "^1.0.0",
        "omega-mvc/serializable-closure":  "^1.0.0",
        "psr/log": "^3.0.2",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^v8.0.7",
        "symfony/finder": "^v8.0.8",
        "vlucas/phpdotenv": "^5.6",
        "wixel/gump": "^v2.3.1",
        "filp/whoops": "^2.18"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^5.1",
        "aws/aws-sdk-php": "^3.394",
        "async-aws/simple-s3": "^3.0",
        "phpseclib/phpseclib": "^2.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Omega\\": "src/Omega/"
        },
        "files": [
            "src/Omega/Application/helper.php",
            "src/Omega/Collection/helper.php",
	    "src/Omega/Environment/helper.php",
            "src/Omega/Http/helper.php",
            "src/Omega/Text/helper.php",
            "src/Omega/Time/helper.php",
            "src/Omega/Validator/helper.php",
            "src/Omega/View/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/phpcs src/ tests/",
        "lint": "composer run phpcs",
        "phpcbf": "vendor/bin/phpcbf src/ tests/",
        "fix": "composer run phpcbf",
        "test": "vendor/bin/pest",
        "check": [
            "composer run lint",
            "composer run test"
        ],
        "ci": [
            "composer run fix",
            "composer run check"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "suggest": {
        "ext-pcntl": "Required for process signal handling in the built-in development server and the view watcher.",
        "ext-posix": "POSIX system functions used in specific CLI/server integrations.",
        "ext-readline": "Interactive input support for CLI commands.",
        "ext-simplexml": "Required to load XML configuration files via the XmlConfig source.",
        "ext-apache": "If you want to use apache extension",
        "ext-apcu": "If you want to use APCu for faster in-memory caching",
        "ext-memcached": "If you want to use Memcached as a cache backend",
        "ext-redis": "If you want to use Redis as a cache backend or for session storage",
        "ext-http": "If you want to use HTTP extension features"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
